# AI Editing Tutor — How to Run
# =================================
# 1. Copy this file to .env and fill in your API key
# 2. cd backend && pip install -r requirements.txt
# 3. uvicorn app.main:app --reload --port 8000
# 4. cd ../frontend && npm install && npm run dev
# 5. Open http://localhost:5173
# 6. (Optional) Terminal demo: cd backend && python run_tools_demo.py

# ── REQUIRED ──────────────────────────────────────────────────────────────────
# Paste any API key — provider is auto-detected from key prefix:
#   AIza / AQ.  → Google Gemini  (FREE at aistudio.google.com/apikey)
#   gsk_        → Groq            (FREE at console.groq.com/keys)
#   sk-         → OpenAI          (platform.openai.com/api-keys)
OPENAI_API_KEY=your_api_key_here

# ── OPTIONAL: override auto-detected values ────────────────────────────────────
# OPENAI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-2.0-flash

# ── DATABASE ───────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./editing_tutor.db
